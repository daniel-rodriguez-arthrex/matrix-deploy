# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Local environment / secrets
.env

# TLS/CA key material - never commit private keys or certs
*.key
*.pem

# Site-specific config profiles (real router IPs / per-room network details) -
# copy config/deploy_config.example.json to create your own. Only the example
# is committed.
config/*.json
!config/deploy_config.example.json

# Per-lab credential files (plaintext SSH/sudo/switch/router passwords).
config/*.env

# Local artifacts
*.swu
*.part
build/
dist/
# PyInstaller regenerates this on every build_exe.ps1 run; not needed in git
*.spec

# OS
.DS_Store
Thumbs.db
