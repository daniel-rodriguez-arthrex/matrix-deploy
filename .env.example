# Matrix Deploy - prefill values
#
# Copy this file to ".env" and edit, or let the app create it when you use
# Settings > Edit saved credentials. Values here prefill the UI on startup.
# This file is gitignored.

ROUTER_IP=10.0.0.1
SSH_USERNAME=your-ssh-user
ARTIFACTORY_EMAIL=your.email@example.com
# Jenkins login ID (NOT your email) - check your account page on the Jenkins
# instance, e.g. https://jenkins-embedded.dev.actsw.net/user/<you>/account/
JENKINS_USERNAME=Your Full Name

# Folders on THIS computer (easiest to set in Settings > Local folders).
# SWU_DOWNLOAD_DIR defaults to <your home>\Desktop\latest-matrix-wrynose.
SWU_DOWNLOAD_DIR=
SWU_FILE=

# Optional: local checkouts of the internal matrix-api-linux / matrix-app-linux
# repos, used by the Web App tab's "Build from source" step.
BACKEND_REPO=
WEB_REPO=
# Optional: already-built output, used by the Web App tab's "Deploy existing build".
WEBAPP_DIST=
WEBAPP_WEB=

# SECURITY WARNING: the values below are SECRETS stored in PLAINTEXT on disk.
# Only fill these in if you accept that tradeoff. Leave them blank to keep the
# in-memory-only posture and type them into the UI each session.
# .env is gitignored and is never included in the distributable build.
SSH_PASSWORD=
SUDO_PASSWORD=
ARTIFACTORY_TOKEN=
JENKINS_TOKEN=
